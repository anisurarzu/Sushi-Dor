// Sushi D'or — production PostgreSQL schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  role         Role      @default(CUSTOMER)
  marketingOptIn Boolean @default(false)
  loyaltyPoints Int      @default(0)
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  addresses    CustomerAddress[]
  orders       Order[]
  reservations Reservation[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Restaurant {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  address             String
  postalCode          String
  city                String
  phone               String?
  email               String?
  lat                 Float?
  lng                 Float?
  isActive            Boolean  @default(true)
  deliveryEnabled     Boolean  @default(false)
  pickupEnabled       Boolean  @default(true)
  dineInEnabled       Boolean  @default(false)
  reservationEnabled  Boolean  @default(true)
  timezone            String   @default("Europe/Paris")
  minOrderCents       Int      @default(0)
  prepTimeMinutes     Int      @default(30)
  reservationInterval Int      @default(30)
  maxGuestsPerSlot    Int      @default(40)
  maxPartySize        Int      @default(12)
  minAdvanceMinutes   Int      @default(60)
  maxAdvanceDays      Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  openingHours OpeningHour[]
  blockedDates BlockedDate[]
  tables       DiningTable[]
  deliveryZones DeliveryZone[]
  orders       Order[]
  reservations Reservation[]
}

model OpeningHour {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    DayOfWeek
  openTime     String // HH:mm
  closeTime    String // HH:mm
  service      String    @default("ALL") // ALL | LUNCH | DINNER | RESERVATION
  isClosed     Boolean   @default(false)

  @@index([restaurantId, dayOfWeek])
}

model BlockedDate {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  reason       String?

  @@unique([restaurantId, date])
}

model DiningTable {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int
  isActive     Boolean  @default(true)
  reservations Reservation[]

  @@index([restaurantId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameFr      String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Allergen {
  id       String            @id @default(cuid())
  code     String            @unique
  nameFr   String
  products ProductAllergen[]
}

model Ingredient {
  id       String              @id @default(cuid())
  nameFr   String              @unique
  products ProductIngredient[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  sku         String?  @unique
  nameFr      String
  description String?
  priceCents  Int
  imageUrl    String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isFeatured  Boolean  @default(false)
  isAvailable Boolean  @default(true)
  isVegetarian Boolean @default(false)
  isVegan     Boolean  @default(false)
  isSpicy     Boolean  @default(false)
  sortOrder   Int      @default(0)
  pieces      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allergens   ProductAllergen[]
  ingredients ProductIngredient[]
  options     ProductOption[]
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([isAvailable, isFeatured])
}

model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameFr     String
  priceDelta Int     @default(0)
  isDefault  Boolean @default(false)

  @@index([productId])
}

model ProductOption {
  id         String              @id @default(cuid())
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameFr     String
  required   Boolean             @default(false)
  maxSelect  Int                 @default(1)
  values     ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  nameFr   String
  priceDelta Int         @default(0)

  @@index([optionId])
}

model DeliveryZone {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  postalCodes  String[] // e.g. ["75001","75002"]
  feeCents     Int
  minOrderCents Int     @default(0)
  isActive     Boolean  @default(true)

  @@index([restaurantId])
}

model Discount {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  percentOff    Int?
  amountOffCents Int?
  minOrderCents Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model CustomerAddress {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  street     String
  complement String?
  postalCode String
  city       String
  isDefault  Boolean @default(false)

  @@index([userId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  restaurantId    String
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id])
  type            OrderType
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  currency        String        @default("EUR")
  subtotalCents   Int
  deliveryFeeCents Int          @default(0)
  discountCents   Int           @default(0)
  totalCents      Int
  discountCode    String?
  customerEmail   String
  customerPhone   String
  customerFirstName String
  customerLastName  String
  deliveryStreet  String?
  deliveryComplement String?
  deliveryPostalCode String?
  deliveryCity    String?
  deliveryNotes   String?
  notes           String?
  estimatedReadyAt DateTime?
  stripeSessionId String?       @unique
  stripePaymentIntentId String? @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([restaurantId, createdAt])
  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id                   String @id @default(cuid())
  orderId              String
  order                Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  productNameSnapshot  String
  unitPriceSnapshot    Int
  quantity             Int
  optionsSnapshot      Json?
  lineTotalCents       Int

  @@index([orderId])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("stripe")
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  currency              String        @default("EUR")
  stripeSessionId       String?
  stripePaymentIntentId String?
  rawEventId            String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
}

model Reservation {
  id               String            @id @default(cuid())
  confirmationCode String            @unique
  cancelTokenHash  String            @unique
  restaurantId     String
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id])
  tableId          String?
  table            DiningTable?      @relation(fields: [tableId], references: [id])
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  status           ReservationStatus @default(CONFIRMED)
  date             DateTime          @db.Date
  startTime        String // HH:mm
  endTime          String // HH:mm
  partySize        Int
  firstName        String
  lastName         String
  email            String
  phone            String
  occasion         String?
  specialRequest   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([restaurantId, date, startTime])
  @@index([email])
  @@index([status])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  consentAt DateTime @default(now())
  source    String?
  isActive  Boolean  @default(true)
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
