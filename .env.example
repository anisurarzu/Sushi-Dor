# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (Neon / Contabo / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sushi_dor?schema=public"

# Auth
AUTH_SECRET="generate-a-long-random-string"

# Stripe — TEST / SANDBOX MODE ONLY during development
# Get keys: https://dashboard.stripe.com/test/apikeys
# Or: stripe sandbox create --email you@example.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Email (Resend)
EMAIL_API_KEY=""
EMAIL_FROM="Sushi D'or <noreply@sushidor.fr>"

# Cloudinary — product image uploads (same pattern as Rootora)
# Dashboard: https://cloudinary.com/console
# When set, images go to Cloudinary folder sushi-dor/products/{productId}
# Without these, local public/uploads is used (dev only — not for Vercel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Local Epson print agent (TM-m30III) — same secret on Vercel + restaurant PC
# See docs/PRINT_AGENT.md
PRINT_AGENT_SECRET=""
